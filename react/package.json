{
  "name": "auricle-react",
  "version": "0.1.1",
  "description": "React hooks for auricle: voice activity detection and interruptible voice conversations in the browser. Drop-in for @ricky0123/vad-react.",
  "keywords": [
    "react",
    "hooks",
    "vad",
    "voice-activity-detection",
    "voice-agent",
    "speech",
    "vad-react",
    "webassembly"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himanshu007-creator/auricle.git",
    "directory": "react"
  },
  "homepage": "https://himanshu007-creator.github.io/auricle/",
  "sideEffects": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/auricle-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/auricle-react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "auricle": ">=0.1.1",
    "react": ">=18"
  },
  "devDependencies": {
    "auricle": "*",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "author": "Himanshu (https://github.com/himanshu007-creator)"
}
